# Ollama runs locally by default and does not require an API key.
# If you later point this tool at a protected/proxied Ollama server, put the
# secret token in your private .env file only. Never commit real secrets.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_REQUEST_TIMEOUT=120

# Optional placeholder for future protected Ollama/proxy setups.
OLLAMA_API_KEY=YOUR_API_KEY_HERE
